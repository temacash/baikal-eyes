# Скопируйте в .env.local для локальной разработки,
# а на Vercel добавьте те же четыре значения в Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_ключ_из_supabase

# Вход в /admin
ADMIN_PASSWORD=придумайте_длинный_пароль
ADMIN_SECRET=случайная_строка_30_символов_и_больше
